# 智谱 GLM（OpenAI 兼容）。留空则 Agent 走本地规则降级。
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
GLM_MODEL=glm-4.7-flash
# 瞬时错误（429/5xx/超时）重试次数与指数退避基准秒数
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF=1.0

# 视觉模型路径（相对项目根）。羊专用权重优先，不存在则用 COCO 兜底 yolov8s.pt。
VISION_MODEL_PATH=models/yolo11n_all.pt
VISION_FALLBACK_MODEL=yolov8s.pt
# 推理设备：auto 优先 CUDA（NVIDIA 或 AMD ROCm SDK 环境，其 torch 同样报告 cuda 可用），否则回退 CPU
VISION_DEVICE=auto
VISION_CONFIDENCE=0.35

# 载畜量默认参数（标准羊单位日食干物质 kg）
DAILY_INTAKE_PER_SHEEP=2.0

# Agent 编排
AGENT_MAX_ROUNDS=8

# 登录鉴权（演示默认 admin / admin123，开箱即用；正式部署必须全部修改）
AUTH_USERNAME=admin
AUTH_PASSWORD=admin123
# 令牌签名密钥（HMAC-SHA256）：改动后所有已签发令牌立即失效
AUTH_TOKEN_SECRET=muyitong-demo-secret-change-me
# 令牌有效期（秒），默认 12 小时
AUTH_TOKEN_TTL_SECONDS=43200
